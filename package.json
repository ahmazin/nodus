{
  "name": "nodus-monorepo",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=text",
    "verify:render": "tsx scripts/render-demo.ts",
    "verify:dist": "pnpm build && node scripts/verify-dist.mjs",
    "nodus": "tsx packages/cli/src/bin.ts",
    "verify:all": "pnpm typecheck && pnpm test && pnpm verify:render && pnpm verify:dist",
    "dev": "pnpm --filter nodus-example-browser dev",
    "gallery": "tsx scripts/gallery.ts",
    "artifact": "node scripts/build-artifact.mjs",
    "serve": "node scripts/serve-playground.mjs",
    "demos": "tsx scripts/demos.ts",
    "leverage": "tsx scripts/leverage.ts",
    "serve:docs": "node scripts/doc-server.mjs",
    "build:icons": "tsx scripts/build-icon-packs.ts",
    "bench": "tsx scripts/bench.mjs",
    "size": "pnpm --filter @nodus-dev/core --filter @nodus-dev/react run size",
    "golden": "tsx scripts/golden/compare.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm verify:all && pnpm build && changeset publish",
    "docs:api": "typedoc"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@napi-rs/canvas": "^1.0.9",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "axe-core": "^4.13.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "1.63.0",
    "pngjs": "^7.0.0",
    "size-limit": "^14.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
