{
  "name": "@nodus/from-mermaid",
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/nodus"
  },
  "license": "MIT",
  "description": "Import a Mermaid diagram (flowchart / state / ER subsets) into Nodus records — reuses @nodus/preset-diagrams builders + any registered layout engine (ELK).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": { "types": "./src/index.ts", "default": "./src/index.ts" } },
  "sideEffects": false,
  "dependencies": { "@nodus/core": "workspace:*", "@nodus/preset-diagrams": "workspace:*" },
  "devDependencies": { "@nodus/layout-elk": "workspace:*" },
  "scripts": { "build": "tsup", "clean": "rm -rf dist" },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" } }
  }
}
