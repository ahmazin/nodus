{
  "name": "@nodus/react",
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/nodus"
  },
  "license": "MIT",
  "description": "Thin React binding for Nodus: <Nodus> canvas host, hooks, and inline text-edit overlay.",
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    }
  },
  "sideEffects": false,
  "peerDependencies": {
    "@nodus/core": "workspace:*",
    "@nodus/stencils": "workspace:*",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@nodus/stencils": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "dependencies": {
    "gifenc": "^1.0.3"
  }
}
