{
  "name": "@nodus-dev/react",
  "version": "0.3.0",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmazin/nodus.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "description": "Thin React binding for Nodus: <Nodus> canvas host, hooks, and inline text-edit overlay.",
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@nodus-dev/core": "workspace:^",
    "@nodus-dev/stencils": "workspace:^",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@nodus-dev/stencils": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^19.3.0",
    "react": "^18.3.1",
    "react-dom": "^19.3.0",
    "@nodus-dev/core": "workspace:*",
    "@nodus-dev/stencils": "workspace:*",
    "gifenc": "^1.0.3"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "react binding ESM (gzip, peers external)",
      "path": "dist/index.js",
      "limit": "60 KB",
      "gzip": true,
      "ignore": [
        "react",
        "react-dom",
        "@nodus-dev/core",
        "@nodus-dev/stencils"
      ]
    }
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/ahmazin/nodus/tree/mainline/packages/react#readme",
  "bugs": {
    "url": "https://github.com/ahmazin/nodus/issues"
  }
}
