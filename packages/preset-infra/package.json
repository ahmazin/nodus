{
  "name": "@nodus-dev/preset-infra",
  "version": "1.0.0",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmazin/nodus.git",
    "directory": "packages/preset-infra"
  },
  "license": "MIT",
  "description": "Infra-architecture preset for Nodus: semantic node types, dark theme, and Studio/Reverse/Evolution mode adapters.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "peerDependencies": {
    "@nodus-dev/core": "workspace:^"
  },
  "devDependencies": {
    "@nodus-dev/core": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/ahmazin/nodus/tree/main/packages/preset-infra#readme",
  "bugs": {
    "url": "https://github.com/ahmazin/nodus/issues"
  }
}
