{
  "name": "@nodus-dev/cli",
  "version": "0.2.0",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmazin/nodus.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "description": "The `nodus` CLI: canonicalize (fmt), render to PNG, and semantically diff Nodus diagram files — the git-native toolchain for diagrams you can code-review.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "nodus": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@nodus-dev/core": "workspace:^",
    "@nodus-dev/import-infra": "workspace:^",
    "@nodus-dev/preset-diagrams": "workspace:^",
    "@nodus-dev/preset-infra": "workspace:^",
    "@nodus-dev/preset-draw": "workspace:^",
    "@napi-rs/canvas": "^0.1.60"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "nodus": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "homepage": "https://github.com/ahmazin/nodus/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/ahmazin/nodus/issues"
  }
}
