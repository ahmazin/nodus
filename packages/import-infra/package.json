{
  "name": "@ahmazin/import-infra",
  "version": "1.0.0",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmazin/nodus.git",
    "directory": "packages/import-infra"
  },
  "license": "MIT",
  "description": "Import live infrastructure into a Nodus diagram: Terraform state/plan JSON and Kubernetes manifests -> infra records.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "dependencies": {
    "@ahmazin/preset-infra": "workspace:^",
    "yaml": "^2.4.2"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "peerDependencies": {
    "@ahmazin/core": "workspace:^"
  },
  "devDependencies": {
    "@ahmazin/core": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/ahmazin/nodus/tree/main/packages/import-infra#readme",
  "bugs": {
    "url": "https://github.com/ahmazin/nodus/issues"
  }
}
