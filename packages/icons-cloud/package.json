{
  "name": "@nodus/icons-cloud",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "_publishHold": "HELD FROM npm PUBLISH pending a licensing decision: this package bundles derived AWS/Azure/GCP provider artwork, whose icon terms permit end-user diagramming but not clearly third-party registry redistribution. See PRE-PUBLICATION-AUDIT.md H4. Consumed locally by examples/browser via workspace:* — no PUBLISHED @nodus/* package depends on it (react is decoupled via the catalog prop). To ship: resolve the terms (or gate to placeholder packs) and remove this flag.",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "LICENSES",
    "provenance.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/nodus.git",
    "directory": "packages/icons-cloud"
  },
  "description": "Cloud-provider icon packs (AWS, Azure, GCP) for Nodus, registered into core's icon registry as namespaced `provider:service` glyphs. Bundles derived provider architecture-icon artwork under each provider's icon terms — see LICENSE, NOTICE, and LICENSES/. Not published to npm pending a redistribution-terms review.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./aws": {
      "types": "./src/aws.ts",
      "default": "./src/aws.ts"
    },
    "./azure": {
      "types": "./src/azure.ts",
      "default": "./src/azure.ts"
    },
    "./gcp": {
      "types": "./src/gcp.ts",
      "default": "./src/gcp.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "devDependencies": {
    "@nodus/preset-diagrams": "workspace:*",
    "svgpath": "^2.6.0",
    "svgson": "^5.3.1",
    "@nodus/core": "workspace:*"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./aws": {
        "import": {
          "types": "./dist/aws.d.ts",
          "default": "./dist/aws.js"
        },
        "require": {
          "types": "./dist/aws.d.cts",
          "default": "./dist/aws.cjs"
        }
      },
      "./azure": {
        "import": {
          "types": "./dist/azure.d.ts",
          "default": "./dist/azure.js"
        },
        "require": {
          "types": "./dist/azure.d.cts",
          "default": "./dist/azure.cjs"
        }
      },
      "./gcp": {
        "import": {
          "types": "./dist/gcp.d.ts",
          "default": "./dist/gcp.js"
        },
        "require": {
          "types": "./dist/gcp.d.cts",
          "default": "./dist/gcp.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "peerDependencies": {
    "@nodus/core": "workspace:^"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/OWNER/nodus/tree/main/packages/icons-cloud#readme",
  "bugs": {
    "url": "https://github.com/OWNER/nodus/issues"
  }
}
