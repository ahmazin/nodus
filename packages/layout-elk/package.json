{
  "name": "@ahmazin/layout-elk",
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmazin/nodus.git",
    "directory": "packages/layout-elk"
  },
  "license": "MIT",
  "description": "ELK (Eclipse Layout Kernel) adapter for Nodus — layered, orthogonal, and nested layouts.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "dependencies": {
    "elkjs": "^0.9.3"
  },
  "devDependencies": {
    "@ahmazin/layout-force": "workspace:*",
    "@ahmazin/layout-tree": "workspace:*",
    "@ahmazin/core": "workspace:*"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "peerDependencies": {
    "@ahmazin/core": "workspace:^"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/ahmazin/nodus/tree/main/packages/layout-elk#readme",
  "bugs": {
    "url": "https://github.com/ahmazin/nodus/issues"
  }
}
