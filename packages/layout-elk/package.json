{
  "name": "@nodus/layout-elk",
  "version": "0.1.0",
  "description": "ELK (Eclipse Layout Kernel) adapter for Nodus — layered, orthogonal, and nested layouts.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": { "types": "./src/index.ts", "default": "./src/index.ts" } },
  "sideEffects": false,
  "dependencies": { "@nodus/core": "workspace:*", "elkjs": "^0.9.3" },
  "scripts": { "build": "tsup", "clean": "rm -rf dist" },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" } }
  }
}
